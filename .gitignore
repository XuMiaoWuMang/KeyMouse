# ============================================================== 构建产物
# 所有本地产物统一落在 artifacts/（目录约定见 docs/guide/environments.md）
artifacts/
# 旧布局的产物目录：已经废弃，留着这两行只是防止老工作区误提交
dist/
out/
bin/
obj/

# ============================================================== IDE
.vs/
.idea/
*.user
*.suo
*.swp

# ============================================================== 操作系统
Thumbs.db
desktop.ini

# ============================================================== 生成物
# 安装程序的内嵌载荷（由 tools/build/pack-release.ps1 生成）
tools/KeyMouse.Setup/Assets/*.zip
src/KeyMouse.Setup/Assets/*.zip

# 测试录制的临时流程与逐步截图（<流程>.json / <流程>.shots/）
x.json
x.shots/
flow.json
__*.png
# 录制产物：截图画到与流程同名的目录里，不该跟着流程文件进仓库
*.shots/

# ============================================================== 只在本地保留
# 设计评审素材与本地快照：随手的截图与备份，不进版本库
.impeccable/
_session-backup/
# Windows 文件权限修复的恢复记录（含权限快照）
.dsh-acl-repair-*/
# 本机 DSH 预设 bundle 源（安装到 DSH profile，不属于本项目产物）
.dsh-presets/
# 本地 GitHub token（tools/release/clean-releases.ps1 读它，用完即删）
.keymouse-github-token
# 前端外壳（Tauri + Vite）：依赖、构建、Rust 中间物
node_modules/
src/KeyMouse.EditorUI/dist/
src/KeyMouse.EditorUI/src-tauri/target/
src/KeyMouse.EditorUI/src-tauri/gen/
