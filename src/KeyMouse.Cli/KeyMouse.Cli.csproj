<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <AssemblyName>KeyMouse</AssemblyName>
    <RootNamespace>KeyMouse.Cli</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <!-- 版本只在根 Directory.Build.props 里写一次。 -->
    <Version>$(ProductVersion)</Version>
    <!-- Per-monitor V2 is set in the manifest because it has to apply before anything (WinForms
         included) starts; WFO0003 asks for the property instead, but the property alone does not
         cover the paths that never touch WinForms. -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <InvariantGlobalization>true</InvariantGlobalization>
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
  </PropertyGroup>

  <PropertyGroup Condition="'$(UIAccessFlavor)' == 'true'">
    <OutputType>WinExe</OutputType>
    <ApplicationManifest>uiaccess.manifest</ApplicationManifest>
    <DefineConstants>$(DefineConstants);UIACCESS_FLAVOR</DefineConstants>
    <StartupHookSupport>false</StartupHookSupport>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\KeyMouse.Core\KeyMouse.Core.csproj" />
    <ProjectReference Include="..\KeyMouse.Runner\KeyMouse.Runner.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="KeyMouse.UIAccess.Tests" />
  </ItemGroup>

  <!-- The privileged helper never hosts an MCP session. -->
  <ItemGroup Condition="'$(UIAccessFlavor)' != 'true'">
    <PackageReference Include="ModelContextProtocol.Core" Version="2.4.0" />
  </ItemGroup>
  <ItemGroup Condition="'$(UIAccessFlavor)' == 'true'">
    <Compile Remove="Mcp\**\*.cs" />
  </ItemGroup>

  <!-- Capability namespaces used from here; the source layout under src\KeyMouse.Core.* follows these capability boundaries. -->
  <ItemGroup>
    <Using Include="KeyMouse.Capture" />
    <Using Include="KeyMouse.Product" />
    <Using Include="KeyMouse.Flow" />
    <Using Include="KeyMouse.Input" />
    <Using Include="KeyMouse.Runtime" />
    <Using Include="KeyMouse.Windowing" />
  </ItemGroup>
</Project>
