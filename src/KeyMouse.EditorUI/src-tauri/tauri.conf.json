{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "KeyMouse 流程编辑器",
  "version": "0.2.1",
  "identifier": "org.keymouse.editor",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:5183",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "KeyMouse 流程编辑器",
        "width": 892,
        "height": 632,
        "minWidth": 760,
        "minHeight": 520,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "icon": []
  }
}
