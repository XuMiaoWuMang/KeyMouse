{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "编辑器主窗口默认能力：核心 API + 文件对话框 + 用系统默认程序打开证据图 + 改自己的标题。文件读写走自己的命令（files.rs），所以不开 fs 插件。",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-set-title",
    "dialog:default",
    "opener:default",
    "opener:allow-open-path",
    "opener:allow-reveal-item-in-dir"
  ]
}
