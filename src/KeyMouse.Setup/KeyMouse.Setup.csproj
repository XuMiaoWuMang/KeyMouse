<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>KeyMouse.Setup</RootNamespace>
    <AssemblyName>KeyMouseSetup</AssemblyName>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Version>$(ProductVersion)</Version>
    <FileVersion>$(ProductVersion).0</FileVersion>
    <Product>KeyMouse 流程编辑器</Product>
    <Company>KeyMouse</Company>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <SatelliteResourceLanguages>zh-Hans</SatelliteResourceLanguages>
    <!-- 安装程序自己要能独立跑：.NET 运行时不一定是有的。 -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <!-- 两个载荷：编辑器本体、命令行。由 tools\build\pack-release.ps1 生成。 -->
  <!-- 安装布局与登记处都是能力层里的同一份契约（ProductRegistry / ProductLayout）：
       安装程序引用它，而不是把源码链进来——链进来就意味着有一天两边会各写一遍。 -->
  <ItemGroup>
    <ProjectReference Include="..\KeyMouse.Core\KeyMouse.Core.csproj" />
  </ItemGroup>

  <ItemGroup Condition="Exists('Assets\flowedit.zip') And Exists('Assets\cli.zip')">
    <EmbeddedResource Include="Assets\flowedit.zip" />
    <EmbeddedResource Include="Assets\cli.zip" />
  </ItemGroup>

  <!-- Capability namespaces used from here; the folder layout under src\KeyMouse.Core carries the same split. -->
  <ItemGroup>
    <Using Include="KeyMouse.Capture" />
    <Using Include="KeyMouse.Product" />
    <Using Include="KeyMouse.Flow" />
    <Using Include="KeyMouse.Input" />
    <Using Include="KeyMouse.Runtime" />
    <Using Include="KeyMouse.Windowing" />
  </ItemGroup>
</Project>
