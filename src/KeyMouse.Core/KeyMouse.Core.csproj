<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <AssemblyName>KeyMouse.Core</AssemblyName>
    <RootNamespace>KeyMouse</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <!-- 引擎线版本：能力层与协议契约的号，跟产品版本分开发（根 Directory.Build.props）。 -->
    <Version>$(EngineVersion)</Version>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- The interactive region picker is the one capability that needs a UI toolkit; the manifest that
         pins DPI awareness belongs to an entry point that starts a process, not to this library. -->
    <UseWindowsForms>true</UseWindowsForms>
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- 流程格式的接口契约：加载器与编辑器共用的唯一权威，随程序集一起分发。 -->
    <EmbeddedResource Include="flow.schema.json" />
  </ItemGroup>

  <ItemGroup>
    <!-- One product, three layers: the CLI and the resident Runner are the two entry points into this
         same capability layer, and the tests and the editor reach into it too. -->
    <InternalsVisibleTo Include="KeyMouse" />
    <InternalsVisibleTo Include="KeyMouse.Runner" />
    <InternalsVisibleTo Include="KeyMouse.Tests" />
    <InternalsVisibleTo Include="KeyMouse.FlowEditor" />
    <InternalsVisibleTo Include="KeyMouseSetup" />
  </ItemGroup>

  <!-- Capability namespaces used from here; the folder layout under src\KeyMouse.Core carries the same split. -->
  <ItemGroup>
    <Using Include="KeyMouse.Capture" />
    <Using Include="KeyMouse.Product" />
    <Using Include="KeyMouse.Flow" />
    <Using Include="KeyMouse.Input" />
    <Using Include="KeyMouse.Runtime" />
    <Using Include="KeyMouse.Windowing" />
    <!-- WinForms 也在 ImplicitUsings 里，它的 NativeWindow 和我们这个同名。 -->
    <Using Include="KeyMouse.Windowing.NativeWindow" Alias="NativeWindow" />
  </ItemGroup>
</Project>
