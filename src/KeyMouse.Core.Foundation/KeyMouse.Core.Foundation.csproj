<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>KeyMouse</RootNamespace>
    <Version>$(EngineVersion)</Version>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../KeyMouse.Core.Abstractions/KeyMouse.Core.Abstractions.csproj" />
    <InternalsVisibleTo Include="KeyMouse.Core.Capture" />
    <InternalsVisibleTo Include="KeyMouse.Core.Flow.Validation" />
    <InternalsVisibleTo Include="KeyMouse.Core.Flow.Execution" />
    <InternalsVisibleTo Include="KeyMouse.Core.Capture.Recording" />
    <InternalsVisibleTo Include="KeyMouse.Core" />
    <InternalsVisibleTo Include="KeyMouse.Tests" />
    <InternalsVisibleTo Include="KeyMouse" />
    <InternalsVisibleTo Include="KeyMouse.Runner" />
    <InternalsVisibleTo Include="KeyMouse.FlowEditor" />
    <InternalsVisibleTo Include="KeyMouseSetup" />
    <Using Include="KeyMouse.Flow" />
    <Using Include="KeyMouse.Product" />
    <Using Include="KeyMouse.Runtime" />
    <Using Include="KeyMouse.Windowing" />
    <Using Include="KeyMouse.Input" />
    <Using Include="KeyMouse.Windowing.NativeWindow" Alias="NativeWindow" />
  </ItemGroup>
  <Import Project="../../tools/build/BackgroundUia.targets" />
</Project>
