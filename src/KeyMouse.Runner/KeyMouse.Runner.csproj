<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <AssemblyName>KeyMouse.Runner</AssemblyName>
    <RootNamespace>KeyMouse.Runner</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Version>2.1.0</Version>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="KeyMouse" />
    <InternalsVisibleTo Include="KeyMouse.Tests" />
    <InternalsVisibleTo Include="KeyMouse.FlowEditor" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\KeyMouse.Core\KeyMouse.Core.csproj" />
  </ItemGroup>

</Project>