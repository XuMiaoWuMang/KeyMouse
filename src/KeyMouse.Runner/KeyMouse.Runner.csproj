<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <AssemblyName>KeyMouse.Runner</AssemblyName>
    <RootNamespace>KeyMouse.Runner</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <!-- 引擎线版本：与 Core 同一个引擎版本号（根 Directory.Build.props）。 -->
    <Version>$(EngineVersion)</Version>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="KeyMouse" />
    <InternalsVisibleTo Include="KeyMouse.Tests" />
    <InternalsVisibleTo Include="KeyMouse.FlowEditor" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\KeyMouse.Core\KeyMouse.Core.csproj" />
  </ItemGroup>

  <!-- Capability namespaces used from here; the folder layout under src\KeyMouse.Core carries the same split. -->
  <ItemGroup>
    <Using Include="KeyMouse.Capture" />
    <Using Include="KeyMouse.Product" />
    <Using Include="KeyMouse.Flow" />
    <Using Include="KeyMouse.Input" />
    <Using Include="KeyMouse.Runtime" />
    <Using Include="KeyMouse.Windowing" />
  </ItemGroup>
</Project>
