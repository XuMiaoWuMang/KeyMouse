<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <AssemblyName>KeyMouse.Tests</AssemblyName>
    <RootNamespace>KeyMouse.Tests</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!-- Deliberately no test framework: a plain console app keeps the build offline and
       dependency-free. Run it from the repository root with:
         dotnet run -c Release -p tests/KeyMouse.Tests/KeyMouse.Tests.csproj -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\KeyMouse.Core\KeyMouse.Core.csproj" />
    <ProjectReference Include="..\..\src\KeyMouse.Runner\KeyMouse.Runner.csproj" />
  </ItemGroup>

  <!-- Capability namespaces used from here; the folder layout under src\KeyMouse.Core carries the same split. -->
  <ItemGroup>
    <Using Include="KeyMouse.Capture" />
    <Using Include="KeyMouse.Product" />
    <Using Include="KeyMouse.Flow" />
    <Using Include="KeyMouse.Input" />
    <Using Include="KeyMouse.Runtime" />
    <Using Include="KeyMouse.Windowing" />
  </ItemGroup>
</Project>
