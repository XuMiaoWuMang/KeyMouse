<Window
    x:Class="KeyMouse.FlowEditor.IslandWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 录制期间的悬浮停止按钮：红底方块 + 白色停机方块，可拖动。
         形状是**圆角方形**：WinUI 3 没有逐像素透明，而 SetWindowRgn 会让窗口内所有子内容
         停止渲染（实测两轮），所以正圆做不到。见 docs/design.md。 -->
    <Grid x:Name="Root" Background="#FFE23B36">
        <Border CornerRadius="22" BorderThickness="1" BorderBrush="#40FFFFFF" />
        <Border Width="14" Height="14" CornerRadius="3" Background="#FFFFFFFF"
                HorizontalAlignment="Center" VerticalAlignment="Center" />
    </Grid>
</Window>
