<Window
    x:Class="KeyMouse.FlowEditor.IslandWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 录制期间的悬浮停止按钮：红底 + 白色方块（■），可拖动。
         形状是圆角方形而不是正圆：给窗口设圆角区域（SetWindowRgn）之后，
         这个窗口里任何子内容都不再渲染，只有根 Background 画得出来（实测两轮）。
         WinUI 3 又没有逐像素透明，所以正圆在这个技术栈里做不到。 -->
    <Grid x:Name="Root" Background="#FFE0322B">
        <Border CornerRadius="18" BorderThickness="1" BorderBrush="#66FFFFFF" />
        <TextBlock Text="&#x25A0;"
                   Foreground="#FFFFFFFF"
                   FontSize="16"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center" />
    </Grid>
</Window>
