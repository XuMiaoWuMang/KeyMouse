<Window
    x:Class="KeyMouse.FlowEditor.IslandWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 录制期间的悬浮停止按钮：红底圆 + 白色方块（用文字画，因为区域裁剪窗口里
         嵌套的形状元素不渲染——Ellipse 与 Border 都试过，只有根 Background 画得出来）。
         可拖动；拖动不会误触发停止（位移超过阈值就不算点击）。 -->
    <Grid x:Name="Root" Background="#FFE0322B">
        <TextBlock Text="■"
                   Foreground="#FFFFFFFF"
                   FontSize="15"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center" />
    </Grid>
</Window>
