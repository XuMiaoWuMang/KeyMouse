<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="KeyMouse.FlowEditor.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:KeyMouse.FlowEditor">

    <Grid x:Name="Root" SizeChanged="OnPaletteSizeChanged" Background="{ThemeResource KpPaperBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="220" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 标题栏：名字在左，文件在右，未保存是一颗朱砂点。 -->
        <Grid x:Name="TitleBar" Grid.Row="0" Height="44" Padding="16,0" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <FontIcon Glyph="&#xE7C9;" FontSize="13" Foreground="{ThemeResource KpInkBrush}" />
                <TextBlock Text="KeyMouse" Style="{StaticResource TitleText}" VerticalAlignment="Center" />
                <TextBlock Text="流程编辑器" VerticalAlignment="Center" FontSize="13"
                           Foreground="{ThemeResource KpInk3Brush}" />
            </StackPanel>
            <TextBlock Grid.Column="1" Text="{x:Bind Model.Subtitle, Mode=OneWay}" VerticalAlignment="Center"
                       HorizontalAlignment="Right" TextTrimming="CharacterEllipsis"
                       FontFamily="{StaticResource KpMonoFont}" FontSize="11"
                       Foreground="{ThemeResource KpInk3Brush}" />
            <TextBlock Grid.Column="2" Text="{x:Bind Model.DirtyMark, Mode=OneWay}" VerticalAlignment="Center"
                       Margin="0,0,140,0" FontSize="11"
                       Foreground="{ThemeResource KpSignalBrush}" />
        </Grid>

        <!-- 工具栏：一条带下划线的纸带。左边加步骤，右边跑。 -->
        <Grid Grid.Row="1" Padding="16,0,16,0" ColumnSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center" Margin="0,0,0,10">
                <StackPanel x:Name="PaletteHost" Orientation="Horizontal" Spacing="2" />
                <Button x:Name="MoreStepsButton" Click="OnMoreSteps" Style="{StaticResource ToolButton}"
                        ToolTipService.ToolTip="按用途挑步骤类型（Ctrl+Shift+A）">
                    <Button.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Control,Shift" Key="A" />
                    </Button.KeyboardAccelerators>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE710;" FontSize="11" />
                        <TextBlock Text="更多" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="0,0,0,10">
                <Button x:Name="PauseButton" Click="OnPauseRun" Visibility="Collapsed" Style="{StaticResource ToolButton}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE769;" FontSize="11" />
                        <TextBlock Text="暂停" />
                    </StackPanel>
                </Button>
                <Button x:Name="StopButton" Click="OnStopRun" Visibility="Collapsed" Style="{StaticResource ToolButton}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE71A;" FontSize="11" />
                        <TextBlock Text="停止" />
                    </StackPanel>
                </Button>
                <Button x:Name="DryRunButton" Click="OnDryRun" Style="{StaticResource ToolButton}"
                        ToolTipService.ToolTip="只做资格检查，不发送任何输入">
                    <TextBlock Text="试运行" Padding="4,0" />
                </Button>
                <Button x:Name="PlayButton" Click="OnPlay" Style="{StaticResource KpPrimaryButton}"
                        ToolTipService.ToolTip="播放（F5）">
                    <Button.KeyboardAccelerators>
                        <KeyboardAccelerator Key="F5" />
                    </Button.KeyboardAccelerators>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE768;" FontSize="11" />
                        <TextBlock Text="播放" FontWeight="SemiBold" />
                    </StackPanel>
                </Button>
                <Border Width="1" Height="20" Margin="6,0" Background="{ThemeResource KpRuleBrush}"
                        VerticalAlignment="Center" />
                <DropDownButton x:Name="FileButton" Style="{StaticResource ToolButton}" ToolTipService.ToolTip="文件">
                    <FontIcon Glyph="&#xE712;" FontSize="12" />
                    <DropDownButton.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedRight"
                                    MenuFlyoutPresenterStyle="{StaticResource KpFlyoutPresenter}">
                            <MenuFlyoutItem x:Name="OpenButton" Text="打开…" Click="OnOpen">
                                <MenuFlyoutItem.KeyboardAccelerators>
                                    <KeyboardAccelerator Modifiers="Control" Key="O" />
                                </MenuFlyoutItem.KeyboardAccelerators>
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE8E5;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem x:Name="SaveButton" Text="保存" Click="OnSave">
                                <MenuFlyoutItem.KeyboardAccelerators>
                                    <KeyboardAccelerator Modifiers="Control" Key="S" />
                                </MenuFlyoutItem.KeyboardAccelerators>
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE74E;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem x:Name="SaveAsButton" Text="另存为…" Click="OnSaveAs">
                                <MenuFlyoutItem.KeyboardAccelerators>
                                    <KeyboardAccelerator Modifiers="Control,Shift" Key="S" />
                                </MenuFlyoutItem.KeyboardAccelerators>
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE792;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem x:Name="PickButton" Text="从屏幕取区域…" Click="OnPickRegion">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE7C5;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuFlyout>
                    </DropDownButton.Flyout>
                </DropDownButton>
            </StackPanel>

            <Border Grid.Row="1" Grid.ColumnSpan="2" Style="{StaticResource Hairline}" />
        </Grid>

        <!-- 工作区：一张纸，左账本（一条脊柱串起全部步骤），右规格表。 -->
        <Grid Grid.Row="2" Padding="16,10,16,0">
            <Border Style="{StaticResource CardBorder}" Padding="0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="ListColumn" Width="1.45*" MinWidth="260" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition x:Name="InspectorColumn" Width="1*" MinWidth="380" />
                    </Grid.ColumnDefinitions>

                    <!-- LedgerHost 会被代码按自身尺寸裁死：WinUI 的面板默认不裁剪子元素，
                         列表里任何落在右缘的绘制（滚动条、悬停底、拖影）都会漏进分隔线那条缝。
                         裁掉以后，缝里只剩我们画的那一条线。 -->
                    <Grid Grid.Column="0" x:Name="LedgerHost" SizeChanged="OnLedgerSizeChanged">
                        <!-- 脊柱：一条 1px 的线，从第一颗珠穿到最后一颗；它是"顺序"本身，不是装饰。 -->
                        <Border Width="1" Margin="15,18,0,18" HorizontalAlignment="Left" VerticalAlignment="Stretch"
                                Background="{ThemeResource KpRuleBrush}" />
                        <!-- 说明：行内列宽 31、珠 11、连线 1，中心都在 15.5；这里宽 1 左边距 15 也在 15.5。三者同一条像素列。 -->

                        <ListView x:Name="StepList" ItemsSource="{x:Bind Model.Rows, Mode=OneWay}" KeyDown="OnStepListKeyDown"
                                  ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollMode="Auto"
                                  ScrollViewer.VerticalScrollBarVisibility="Hidden" ScrollViewer.VerticalScrollMode="Auto"
                                  SelectionMode="Single" SelectionChanged="OnStepSelected"
                                  ItemContainerTransitions="{x:Null}" Padding="0,16,0,8" Background="Transparent">
                            <ListView.ContextFlyout>
                                <MenuFlyout MenuFlyoutPresenterStyle="{StaticResource KpFlyoutPresenter}">
                                    <MenuFlyoutItem Text="复制这一步" Click="OnDuplicate" />
                                    <MenuFlyoutItem Text="删除这一步" Click="OnDelete" />
                                    <MenuFlyoutSeparator />
                                    <MenuFlyoutItem Text="上移" Click="OnMoveUp" />
                                    <MenuFlyoutItem Text="下移" Click="OnMoveDown" />
                                </MenuFlyout>
                            </ListView.ContextFlyout>
                            <!-- 不要在这里挂 KeyboardAccelerator Key="Delete"：WinUI 会为它生成一个
                                 系统提示气泡（中文系统显示为"删除"），鼠标悬停时莫名其妙地冒出来。
                                 删除键已经由 OnStepListKeyDown 处理，不需要加速器。 -->
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="MinHeight" Value="38" />
                                    <!-- 系统的焦点黑方框留在纸上太脏，而且选中态已经由珠 + 纸色说清（单选列表里焦点即选中）。 -->
                                    <Setter Property="UseSystemFocusVisuals" Value="False" />
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="local:StepVm">
                                    <Grid Height="38" ColumnSpacing="8" Padding="0,0,14,0" Tapped="OnRowTapped"
                                          Background="{x:Bind RowBrush, Mode=OneWay}"
                                          Opacity="{x:Bind RowOpacity, Mode=OneWay}">
                                        <Grid.ColumnDefinitions>
                                            <!-- 31 是奇数：珠子（11）与连线（1）都能居中在 15.5 这个整数半边上，
                                                 和背景脊线的 1px 完全重合——不会再出现半像素错位。 -->
                                            <ColumnDefinition Width="31" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <!-- 正在执行：行首 2px 朱砂细条。一屏只有一条，它的位置就是"现在到哪儿了"。 -->
                                        <Border Width="2" HorizontalAlignment="Left" VerticalAlignment="Stretch"
                                                Background="{ThemeResource KpSignalBrush}"
                                                Visibility="{x:Bind ActivityVisibility, Mode=OneWay}" />

                                        <!-- 脊柱：珠的上下各一段连线。只有这一条线——子步骤不另起分支线。
                                             选中的行把这两段加粗成朱砂，结点之间的连接因此看得见。 -->
                                        <Grid Grid.Column="0">
                                            <Border Width="1" Height="19" HorizontalAlignment="Center" VerticalAlignment="Top"
                                                    Background="{x:Bind ConnectorBrush, Mode=OneWay}"
                                                    Visibility="{x:Bind ConnectorVisibility, Mode=OneWay}" />
                                            <Border Width="1" Height="19" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                                                    Background="{x:Bind ConnectorBrush, Mode=OneWay}"
                                                    Visibility="{x:Bind ConnectorVisibility, Mode=OneWay}" />
                                            <Border Width="11" Height="11" CornerRadius="6" HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Background="{x:Bind BeadBrush, Mode=OneWay}"
                                                    BorderBrush="{x:Bind BeadRingBrush, Mode=OneWay}" BorderThickness="2" />
                                        </Grid>
                                        <TextBlock Grid.Column="1" Text="{x:Bind Number, Mode=OneWay}"
                                                   Style="{StaticResource LedgerNumber}"
                                                   Foreground="{x:Bind NumberBrush, Mode=OneWay}" />

                                        <!-- 内容：子步骤只缩进这里，珠与编号始终落在同一条竖线上。 -->
                                        <Grid Grid.Column="2" ColumnSpacing="10" Margin="{x:Bind IndentMargin, Mode=OneWay}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border Width="24" Height="24" CornerRadius="4"
                                                    Background="{x:Bind BadgeBrush, Mode=OneWay}">
                                                <FontIcon Glyph="{x:Bind Glyph}" FontSize="11"
                                                          Foreground="{x:Bind BadgeInk, Mode=OneWay}" />
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <!-- MaxLines=1：内容和摘要都不许换行；换行会把 38px 的行撑破、盖住下一行。 -->
                                                <TextBlock Text="{x:Bind TypeName}" Style="{StaticResource SectionHeader}"
                                                           TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" MaxLines="1" />
                                                <TextBlock Text="{x:Bind Summary, Mode=OneWay}"
                                                           FontSize="11" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                                           MaxLines="1" Foreground="{ThemeResource KpInk3Brush}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8"
                                                        VerticalAlignment="Center" Margin="0,0,8,0">
                                                <TextBlock Text="{x:Bind PreviewTag, Mode=OneWay}" VerticalAlignment="Center"
                                                           Visibility="{x:Bind PreviewTagVisibility, Mode=OneWay}"
                                                           FontFamily="{StaticResource KpMonoFont}" FontSize="10"
                                                           Foreground="{ThemeResource KpInk3Brush}" />
                                                <!-- 有多于一个子项时给个开合标记：点父行一次展开，再点一次收起。 -->
                                                <FontIcon Glyph="{x:Bind Chevron, Mode=OneWay}" FontSize="10"
                                                          VerticalAlignment="Center"
                                                          Visibility="{x:Bind ToggleVisibility, Mode=OneWay}"
                                                          Foreground="{ThemeResource KpInk3Brush}" />
                                                <TextBlock Text="{x:Bind ChildCount, Mode=OneWay}"
                                                           Visibility="{x:Bind ChildCountVisibility, Mode=OneWay}"
                                                           VerticalAlignment="Center" FontFamily="{StaticResource KpMonoFont}"
                                                           FontSize="11" Foreground="{ThemeResource KpInk3Brush}" />
                                                <StackPanel Orientation="Horizontal" Spacing="6"
                                                            Visibility="{x:Bind RunVisibility, Mode=OneWay}">
                                                    <FontIcon Glyph="{x:Bind RunGlyph, Mode=OneWay}" FontSize="11" />
                                                    <TextBlock Text="{x:Bind RunDetail, Mode=OneWay}" VerticalAlignment="Center"
                                                               FontFamily="{StaticResource KpMonoFont}" FontSize="11"
                                                               Foreground="{ThemeResource KpInk3Brush}" />
                                                </StackPanel>
                                            </StackPanel>
                                            <Border Grid.ColumnSpan="3" VerticalAlignment="Bottom" Height="1"
                                                    Background="{ThemeResource KpRuleBrush}" />
                                        </Grid>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <StackPanel x:Name="EmptyDocHint" VerticalAlignment="Center" HorizontalAlignment="Center"
                                    MaxWidth="320" Spacing="6" Visibility="Collapsed">
                            <TextBlock Text="空流程" Style="{StaticResource SectionHeader}" />
                            <TextBlock Style="{StaticResource FieldCaption}"
                                       Text="从上面挑一个动作加进来；按 Ctrl+Shift+A 看全部类型。" />
                        </StackPanel>
                    </Grid>

                    <!-- 1px 常显，正好落在列边界：行底的色带与它对齐。8px 热区压在这条线两侧。 -->
                    <!-- Width=8 / Height=Auto：Splitter 的构造函数把宽高都设成 8，竖着用的时候必须把高度放开，
                         否则它只是缝里一个小小的 8×8 方块（实测就是那块"莫名其妙的色块"）。 -->
                    <local:Splitter Grid.Column="1" x:Name="VerticalSplitter" Target="{x:Bind InspectorColumn}" Edge="Left"
                                    Direction="Horizontal" Invert="True" MinTarget="320" MaxTarget="820"
                                    Width="8" Height="Auto" VerticalAlignment="Stretch"
                                    MinWidth="8" MinHeight="0"
                                    Visibility="{x:Bind HasSelection, Mode=OneWay}" />

                    <!-- 规格表：左栏是字段名，右栏是值。 -->
                    <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Visible" VerticalScrollMode="Auto">
                        <StackPanel Margin="20,16,20,20" Spacing="16" Visibility="{x:Bind HasSelection, Mode=OneWay}">
                            <StackPanel x:Name="InspectorHost" Spacing="16" />
                            <StackPanel Spacing="6">
                                <Button Click="OnToggleJson" Style="{StaticResource ToolButton}" Padding="0"
                                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                        ToolTipService.ToolTip="展开或收起这一步的 JSON">
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="JSON" Style="{StaticResource MicroLabel}" VerticalAlignment="Center" />
                                        <FontIcon Grid.Column="1" Glyph="{x:Bind JsonChevron, Mode=OneWay}" FontSize="10"
                                                  VerticalAlignment="Center"
                                                  Foreground="{ThemeResource KpInk3Brush}" />
                                    </Grid>
                                </Button>
                                <Border Style="{StaticResource Hairline}" />
                                <TextBox Text="{x:Bind SelectedStep.Json, Mode=OneWay}" IsReadOnly="True"
                                         Visibility="{x:Bind JsonVisibility, Mode=OneWay}"
                                         TextWrapping="Wrap" AcceptsReturn="True" FontFamily="{StaticResource KpMonoFont}"
                                         FontSize="11" Background="{ThemeResource KpFieldBrush}"
                                         BorderBrush="{ThemeResource KpRuleBrush}" BorderThickness="1" CornerRadius="4"
                                         MinHeight="80" MaxHeight="200" Margin="0,4,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- 起始面：没有打开流程时，它拥有整张纸。 -->
                    <Grid Grid.ColumnSpan="3" Visibility="{x:Bind StartScroll.Visibility, Mode=OneWay}">
                        <ScrollViewer x:Name="StartScroll" VerticalScrollBarVisibility="Auto" VerticalScrollMode="Auto"
                                      HorizontalScrollMode="Disabled">
                            <StackPanel x:Name="EmptyState" HorizontalAlignment="Left" VerticalAlignment="Top"
                                        MaxWidth="640" Spacing="16" Padding="24,24,24,20">
                                <TextBlock Text="还没有打开流程" Style="{StaticResource PaneTitle}" />
                                <TextBlock Style="{StaticResource FieldCaption}" MaxWidth="520" TextWrapping="Wrap"
                                           Text="一条流程就是一串动作：切到某个窗口、点一下、输入文字、等屏幕上出现某段字。写好后可以先试运行，确认真能走通再播放。" />
                                <Border Style="{StaticResource Hairline}" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button x:Name="StartNewButton" Content="新建流程" Click="OnNewFlow"
                                            Style="{StaticResource KpPrimaryButton}"
                                            ToolTipService.ToolTip="新建流程（Ctrl+N）">
                                        <Button.KeyboardAccelerators>
                                            <KeyboardAccelerator Modifiers="Control" Key="N" />
                                        </Button.KeyboardAccelerators>
                                    </Button>
                                    <Button x:Name="StartOpenButton" Content="打开流程…" Click="OnOpen" Padding="16,7" />
                                </StackPanel>
                                <StackPanel x:Name="RecentBlock" Spacing="6" Visibility="Collapsed">
                                    <TextBlock Text="最近" Style="{StaticResource MicroLabel}" />
                                    <StackPanel x:Name="RecentList" Spacing="0" />
                                </StackPanel>
                                <Border Style="{StaticResource Hairline}" />
                                <TextBlock Style="{StaticResource FieldCaption}" TextWrapping="Wrap"
                                           Text="想先录一段？在命令行跑 KeyMouse record，再打开它写出的 JSON。" />
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <local:Splitter Grid.Row="3" x:Name="HorizontalSplitter" Target="{x:Bind LogRow}" Edge="Top"
                        Direction="Vertical" Invert="True" MinTarget="0" MaxTarget="420"
                        Width="Auto" Height="8" HorizontalAlignment="Stretch"
                        Visibility="{x:Bind LogSplitterVisibility, Mode=OneWay}" Margin="16,0,16,0" />

        <Grid Grid.Row="4" Padding="16,8,16,16">
            <Grid.RowDefinitions>
                <RowDefinition x:Name="LogRow" Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{StaticResource CardBorder}" Padding="14,12"
                    Visibility="{x:Bind OutputVisibility, Mode=OneWay}">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="运行输出" Style="{StaticResource MicroLabel}" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Click="OnClearLog" Style="{StaticResource ToolButton}"
                                ToolTipService.ToolTip="清空输出">
                            <FontIcon Glyph="&#xE74D;" FontSize="11" />
                        </Button>
                    </Grid>

                    <Grid x:Name="RunSummary" Grid.Row="1" Visibility="Collapsed" Margin="0,2,0,2" ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon x:Name="RunSummaryIcon" Grid.Column="0" FontSize="12" VerticalAlignment="Top" Margin="0,2,0,0" />
                        <TextBlock x:Name="RunSummaryText" Grid.Column="1" TextWrapping="Wrap" VerticalAlignment="Center" />
                        <Button x:Name="RunSummaryJump" Grid.Column="2" Content="选中失败的那一步" Click="OnJumpToFailure"
                                Visibility="Collapsed" Padding="10,4" />
                    </Grid>

                    <!-- 日志换行显示，不横向滚动：一行太长时横向拉来拉去看日志是最糟的阅读方式。 -->
                    <TextBox x:Name="LogBox" Grid.Row="2" IsReadOnly="True" AcceptsReturn="True"
                             TextWrapping="Wrap" IsTextPredictionEnabled="False"
                             FontFamily="{StaticResource KpMonoFont}" FontSize="11" Padding="8"
                             Background="{ThemeResource KpFieldBrush}" BorderBrush="{ThemeResource KpRuleBrush}"
                             BorderThickness="1" CornerRadius="4"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Visible" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
