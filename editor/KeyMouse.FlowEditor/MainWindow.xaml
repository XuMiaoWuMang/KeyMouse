<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="KeyMouse.FlowEditor.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:KeyMouse.FlowEditor">

    <Grid x:Name="Root" SizeChanged="OnPaletteSizeChanged">
        <Grid.Resources>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="220" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 标题栏 -->
        <Grid x:Name="TitleBar" Grid.Row="0" Height="44" Padding="16,0" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <FontIcon Glyph="&#xE7C9;" FontSize="16" />
                <TextBlock Text="KeyMouse 流程编辑器" Style="{StaticResource SectionHeader}"
                           VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock Grid.Column="1" Text="{x:Bind Model.Subtitle, Mode=OneWay}" VerticalAlignment="Center"
                       HorizontalAlignment="Right" TextTrimming="CharacterEllipsis"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <TextBlock Grid.Column="2" Text="{x:Bind Model.DirtyMark, Mode=OneWay}" VerticalAlignment="Center"
                       Margin="0,0,140,0" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
        </Grid>

        <!-- 工具栏：常用动作在左（加步骤、跑），文件操作收进"文件"菜单 -->
        <Grid Grid.Row="1" Padding="16,2,16,10" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" Spacing="6">
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                              HorizontalScrollMode="Auto" VerticalAlignment="Center">
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                                    HorizontalScrollMode="Auto" VerticalAlignment="Center">
                        <StackPanel x:Name="PaletteHost" Orientation="Horizontal" Spacing="6" />
                    </ScrollViewer>
                </ScrollViewer>
                <Button x:Name="MoreStepsButton" Click="OnMoreSteps" Style="{StaticResource ToolButton}" ToolTipService.ToolTip="按用途挑步骤类型（Ctrl+Shift+A）">
                    <Button.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Control,Shift" Key="A" />
                    </Button.KeyboardAccelerators>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE710;" FontSize="14" />
                        <TextBlock Text="更多" />
                    </StackPanel>
                </Button>

                <Border Width="1" Height="24" Margin="4,0" Background="{ThemeResource DividerStrokeColorDefaultBrush}"
                        VerticalAlignment="Center" />

            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <Button x:Name="PauseButton" Click="OnPauseRun" Visibility="Collapsed" Style="{StaticResource ToolButton}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE769;" FontSize="14" />
                        <TextBlock Text="暂停" />
                    </StackPanel>
                </Button>
                <Button x:Name="StopButton" Click="OnStopRun" Visibility="Collapsed" Style="{StaticResource ToolButton}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE71A;" FontSize="14" />
                        <TextBlock Text="停止" />
                    </StackPanel>
                </Button>
                <Button x:Name="DryRunButton" Click="OnDryRun" Style="{StaticResource ToolButton}"
                        ToolTipService.ToolTip="只做资格检查，不发送任何输入">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE768;" FontSize="14" />
                        <TextBlock Text="试运行" />
                    </StackPanel>
                </Button>
                <Button x:Name="PlayButton" Click="OnPlay" Style="{StaticResource AccentButtonStyle}" Padding="14,6"
                        ToolTipService.ToolTip="播放（F5）">
                    <Button.KeyboardAccelerators>
                        <KeyboardAccelerator Key="F5" />
                    </Button.KeyboardAccelerators>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE768;" FontSize="14" />
                        <TextBlock Text="播放" />
                    </StackPanel>
                </Button>

                <DropDownButton x:Name="FileButton" Style="{StaticResource ToolButton}" ToolTipService.ToolTip="文件">
                    <FontIcon Glyph="&#xE712;" FontSize="14" />
                    <DropDownButton.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedRight">
                            <MenuFlyoutItem x:Name="OpenButton" Text="打开…" Click="OnOpen">
                            <MenuFlyoutItem.KeyboardAccelerators>
                                <KeyboardAccelerator Modifiers="Control" Key="O" />
                            </MenuFlyoutItem.KeyboardAccelerators>
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE8E5;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem x:Name="SaveButton" Text="保存" Click="OnSave">
                            <MenuFlyoutItem.KeyboardAccelerators>
                                <KeyboardAccelerator Modifiers="Control" Key="S" />
                            </MenuFlyoutItem.KeyboardAccelerators>
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE74E;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem x:Name="SaveAsButton" Text="另存为…" Click="OnSaveAs">
                            <MenuFlyoutItem.KeyboardAccelerators>
                                <KeyboardAccelerator Modifiers="Control,Shift" Key="S" />
                            </MenuFlyoutItem.KeyboardAccelerators>
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE792;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem x:Name="PickButton" Text="从屏幕取区域…" Click="OnPickRegion">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE7C5;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuFlyout>
                    </DropDownButton.Flyout>
                </DropDownButton>
            </StackPanel>
        </Grid>

        <!-- 步骤列表 + 配置：中间的分隔条可以拖，配置区想多宽就多宽 -->
        <Grid Grid.Row="2" Padding="16,0,16,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="ListColumn" Width="1.4*" MinWidth="260" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition x:Name="InspectorColumn" Width="1*" MinWidth="380" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource CardBorder}" Padding="8">
                <Grid>
                    <ListView x:Name="StepList" ItemsSource="{x:Bind Model.Steps, Mode=OneWay}" KeyDown="OnStepListKeyDown"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollMode="Auto"
                              SelectionMode="Single" SelectionChanged="OnStepSelected"
                              CanReorderItems="True" CanDragItems="True" AllowDrop="True"
                              ItemContainerTransitions="{x:Null}">
                        <ListView.ContextFlyout>
                            <MenuFlyout>
                                <MenuFlyoutItem Text="复制这一步" Click="OnDuplicate" />
                                <MenuFlyoutItem Text="删除这一步" Click="OnDelete" />
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem Text="上移" Click="OnMoveUp" />
                                <MenuFlyoutItem Text="下移" Click="OnMoveDown" />
                            </MenuFlyout>
                        </ListView.ContextFlyout>                        <ListView.KeyboardAccelerators>
                            <KeyboardAccelerator Key="Delete" />
                        </ListView.KeyboardAccelerators>
                        <ListView.ItemContainerStyle>
                            <!-- ListViewItem 默认按内容宽度排（Left），于是行里的 * 列没有空间可分，
                                 摘要会被压成一列一个字。让行撑满列表宽度，列宽才按定义分配。 -->
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="0" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="local:StepVm">
                                <Grid ColumnSpacing="12" Padding="4,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Bind Number, Mode=OneWay}" Width="22" TextAlignment="Right"
                                               VerticalAlignment="Center" Opacity="0.55"
                                               Style="{StaticResource CaptionTextBlockStyle}" />
                                    <!-- 徽标的面色跟着"这一行是不是选中的"走：只有选中那一行是强调色。
                                         写死成强调色的话，选中态就少了最明显的那一个信号（实测：看起来像点了没反应）。 -->
                                    <Border Grid.Column="1" Width="28" Height="28" CornerRadius="6"
                                                Background="{x:Bind BadgeBrush, Mode=OneWay}">
                                            <FontIcon Glyph="{x:Bind Glyph}" FontSize="13"
                                                      Foreground="{x:Bind BadgeInk, Mode=OneWay}" />
                                        </Border>
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind TypeName}" Style="{StaticResource SectionHeader}"
                                                       TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{x:Bind Summary, Mode=OneWay}"
                                                       Style="{StaticResource CaptionTextBlockStyle}"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                       TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6"
                                                    VerticalAlignment="Center" Margin="0,0,12,0"
                                                    Visibility="{x:Bind RunVisibility, Mode=OneWay}">
                                            <FontIcon Glyph="{x:Bind RunGlyph, Mode=OneWay}" FontSize="13" />
                                            <TextBlock Text="{x:Bind RunDetail, Mode=OneWay}" VerticalAlignment="Center"
                                                       Style="{StaticResource FieldCaption}" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <!-- 空白文档：已经新建了，只是还没步骤。这时要回答"第一步怎么加"。 -->
                        <StackPanel x:Name="EmptyDocHint" VerticalAlignment="Center" HorizontalAlignment="Center"
                                    MaxWidth="360" Spacing="8" Visibility="Collapsed">
                            <TextBlock Text="还没有步骤" Style="{StaticResource PaneTitle}" />
                            <TextBlock Style="{StaticResource FieldCaption}" TextWrapping="Wrap"
                                       Text="用工具栏上那排常用步骤直接加一步，或者点「更多」按用途挑；也可以按 Ctrl+Shift+A。" />
                        </StackPanel>

                        <!-- 起始面必须能滚：内容比卡片高时，宁可滚动，也不许把标题切成半截字。
                             注意：要收起的是**这个 ScrollViewer**，不是里面的 EmptyState。
                             只收起里面的内容，外层这块看不见的滚动面仍然盖在步骤列表上，
                             点击与按键全被它吃掉——实测：点任何一行都没反应。 -->
                        <ScrollViewer x:Name="StartScroll" VerticalScrollBarVisibility="Auto" VerticalScrollMode="Auto" HorizontalScrollMode="Disabled">
                            <StackPanel x:Name="EmptyState" HorizontalAlignment="Stretch"
                                        MaxWidth="520" Spacing="24" Padding="0,16">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="还没有打开流程" Style="{StaticResource PaneTitle}" />
                                    <TextBlock Style="{StaticResource FieldCaption}" TextWrapping="Wrap"
                                               Text="流程是一串步骤：切窗口、点击、输入文字、等某段文字出现。搭好之后可以先试运行，确认真能走通再播放。" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button x:Name="StartNewButton" Content="新建流程" Click="OnNewFlow"
                                            Style="{StaticResource AccentButtonStyle}" Padding="16,8"
                                            ToolTipService.ToolTip="新建流程（Ctrl+N）">
                                        <Button.KeyboardAccelerators>
                                            <KeyboardAccelerator Modifiers="Control" Key="N" />
                                        </Button.KeyboardAccelerators>
                                    </Button>
                                    <Button x:Name="StartOpenButton" Content="打开流程…" Click="OnOpen" Padding="16,8" />
                                </StackPanel>
                                <StackPanel x:Name="RecentBlock" Spacing="8" Visibility="Collapsed">
                                    <TextBlock Text="最近打开" Style="{StaticResource SectionHeader}" />
                                    <StackPanel x:Name="RecentList" Spacing="2" />
                                </StackPanel>
                                <TextBlock Style="{StaticResource FieldCaption}" TextWrapping="Wrap"
                                           Text="想先录一段操作？在命令行运行 KeyMouse record，再打开它生成的 JSON。" />
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <local:Splitter Grid.Column="1" x:Name="VerticalSplitter" Target="{x:Bind InspectorColumn}" Edge="Left"
                                Direction="Horizontal" Invert="True" MinTarget="320" MaxTarget="820"
                                MinWidth="8" MinHeight="0" /><ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Visible" VerticalScrollMode="Auto">
                    <StackPanel Spacing="12" Visibility="{x:Bind HasSelection, Mode=OneWay}">
                        <StackPanel x:Name="InspectorHost" Spacing="16" />
                        <Border Style="{StaticResource CardBorder}">
                            <Expander Header="这一步的 JSON（调试视图）">
                                <TextBox Text="{x:Bind SelectedStep.Json, Mode=OneWay}" IsReadOnly="True"
                                         TextWrapping="Wrap" AcceptsReturn="True" FontFamily="Consolas"
                                         FontSize="12" MinHeight="100" MaxHeight="240" />
                            </Expander>
                        </Border>
                    </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- 运行输出：没输出时只有一行标题，有输出才展开；高度可以拖 -->
        <local:Splitter Grid.Row="3" x:Name="HorizontalSplitter" Target="{x:Bind LogRow}" Edge="Top"
                        Direction="Vertical" Invert="True" MinTarget="0" MaxTarget="420"
                        Visibility="{x:Bind LogSplitterVisibility, Mode=OneWay}" />

        <Grid Grid.Row="4" Padding="16,6,16,14" RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition x:Name="LogRow" Height="Auto" />
            </Grid.RowDefinitions>


            <Border Grid.Row="1" Style="{StaticResource CardBorder}" Padding="10"
                    Visibility="{x:Bind OutputVisibility, Mode=OneWay}">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="运行输出" Style="{StaticResource SectionHeader}" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Click="OnClearLog" Style="{StaticResource ToolButton}"
                                ToolTipService.ToolTip="清空输出">
                            <FontIcon Glyph="&#xE74D;" FontSize="13" />
                        </Button>
                    </Grid>

                <!-- 运行结论：跑完就地写在这儿。不弹模态、也不用一闪而过的提示打发人。 -->
                <Grid x:Name="RunSummary" Grid.Row="1" Visibility="Collapsed" Margin="0,10,0,4" ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon x:Name="RunSummaryIcon" Grid.Column="0" FontSize="14" VerticalAlignment="Top" Margin="0,2,0,0" />
                    <TextBlock x:Name="RunSummaryText" Grid.Column="1" TextWrapping="Wrap" VerticalAlignment="Center" />
                    <Button x:Name="RunSummaryJump" Grid.Column="2" Content="选中失败的那一步" Click="OnJumpToFailure"
                            Visibility="Collapsed" />
                </Grid>
                    <TextBox x:Name="LogBox" Grid.Row="2" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
                             FontFamily="Consolas" FontSize="12"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto"
                             ScrollViewer.VerticalScrollBarVisibility="Visible" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
