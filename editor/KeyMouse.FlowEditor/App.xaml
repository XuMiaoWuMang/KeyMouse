<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="KeyMouse.FlowEditor.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!--
              工程纸（Engineering Paper）

              纸、墨、朱砂，三样东西。没有第四样。
                · 纸面是暖白，卡片是它的提亮，不是另一种灰。
                · 墨色分三档，全是同一个暖黑，深浅不同而已。
                · 朱砂只有一个用法：**当前**与**可动**（主操作、选中珠、未保存点、报错除外）。
              控件 4px、面板 8px；没有投影；没有浮层；线只有 1px 一种。
            -->

            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="KpPaperBrush" Color="#FAF7F2" />
                    <SolidColorBrush x:Key="KpCardBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="KpInkBrush" Color="#17140F" />
                    <SolidColorBrush x:Key="KpInk2Brush" Color="#6A655C" />
                    <SolidColorBrush x:Key="KpInk3Brush" Color="#A39C90" />
                    <SolidColorBrush x:Key="KpRuleBrush" Color="#E6E1D8" />
                    <SolidColorBrush x:Key="KpFieldBrush" Color="#F5F1E9" />
                    <SolidColorBrush x:Key="KpSelectedBrush" Color="#F2ECE2" />
                    <SolidColorBrush x:Key="KpSignalBrush" Color="#C2410C" />
                    <SolidColorBrush x:Key="KpSignalHoverBrush" Color="#A83709" />
                    <SolidColorBrush x:Key="KpSignalPressedBrush" Color="#8E2E06" />
                    <SolidColorBrush x:Key="KpSignalOffBrush" Color="#EFE7DA" />
                    <SolidColorBrush x:Key="KpOnSignalBrush" Color="#FFFFFF" />

                    <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#17140F" />
                    <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#6A655C" />
                    <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="#A39C90" />
                    <SolidColorBrush x:Key="DividerStrokeColorDefaultBrush" Color="#E6E1D8" />
                    <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="#E6E1D8" />
                    <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="CardBackgroundFillColorSecondaryBrush" Color="#F5F1E9" />
                    <SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="ControlFillColorSecondaryBrush" Color="#F5F1E9" />
                    <SolidColorBrush x:Key="ControlFillColorTransparentBrush" Color="Transparent" />
                    <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#C2410C" />
                    <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#C2410C" />
                    <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#C2410C" />
                    <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="SystemFillColorCriticalBrush" Color="#B3261E" />
                    <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="#A39C90" />
                    <SolidColorBrush x:Key="AccentButtonBackground" Color="#C2410C" />
                    <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="#A83709" />
                    <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="#8E2E06" />
                    <SolidColorBrush x:Key="AccentButtonBackgroundDisabled" Color="#F0E9DE" />
                    <SolidColorBrush x:Key="AccentButtonForeground" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="AccentButtonForegroundPointerOver" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="AccentButtonForegroundPressed" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="AccentButtonForegroundDisabled" Color="#A39C90" />
                    <SolidColorBrush x:Key="AccentButtonBorderBrush" Color="Transparent" />
                    <SolidColorBrush x:Key="FocusVisualPrimaryBrush" Color="#C2410C" />
                    <SolidColorBrush x:Key="FocusVisualSecondaryBrush" Color="Transparent" />
                    <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="#C2410C" />
                    <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver" Color="#A83709" />
                    <SolidColorBrush x:Key="ToggleSwitchFillOnPressed" Color="#8E2E06" />
                    <SolidColorBrush x:Key="ListViewItemBackgroundPointerOver" Color="#F5F1E9" />
                    <SolidColorBrush x:Key="ListViewItemBackgroundSelected" Color="#F2ECE2" />
                    <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver" Color="#EFE7DA" />
                    <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPressed" Color="#EFE7DA" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="KpPaperBrush" Color="#141312" />
                    <SolidColorBrush x:Key="KpCardBrush" Color="#1B1917" />
                    <SolidColorBrush x:Key="KpInkBrush" Color="#F5F0E8" />
                    <SolidColorBrush x:Key="KpInk2Brush" Color="#A9A29A" />
                    <SolidColorBrush x:Key="KpInk3Brush" Color="#6E6862" />
                    <SolidColorBrush x:Key="KpRuleBrush" Color="#2B2825" />
                    <SolidColorBrush x:Key="KpFieldBrush" Color="#201D1A" />
                    <SolidColorBrush x:Key="KpSelectedBrush" Color="#24201C" />
                    <SolidColorBrush x:Key="KpSignalBrush" Color="#FF8A5B" />
                    <SolidColorBrush x:Key="KpSignalHoverBrush" Color="#FF9C72" />
                    <SolidColorBrush x:Key="KpSignalPressedBrush" Color="#E5764A" />
                    <SolidColorBrush x:Key="KpSignalOffBrush" Color="#2B2825" />
                    <SolidColorBrush x:Key="KpOnSignalBrush" Color="#1A0F08" />

                    <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#F5F0E8" />
                    <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#A9A29A" />
                    <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="#6E6862" />
                    <SolidColorBrush x:Key="DividerStrokeColorDefaultBrush" Color="#2B2825" />
                    <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="#2B2825" />
                    <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="#1B1917" />
                    <SolidColorBrush x:Key="CardBackgroundFillColorSecondaryBrush" Color="#201D1A" />
                    <SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="#1B1917" />
                    <SolidColorBrush x:Key="ControlFillColorSecondaryBrush" Color="#201D1A" />
                    <SolidColorBrush x:Key="ControlFillColorTransparentBrush" Color="Transparent" />
                    <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#FF8A5B" />
                    <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#FF8A5B" />
                    <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#FF8A5B" />
                    <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="#1A0F08" />
                    <SolidColorBrush x:Key="SystemFillColorCriticalBrush" Color="#FF99A4" />
                    <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="#6E6862" />
                    <SolidColorBrush x:Key="AccentButtonBackground" Color="#FF8A5B" />
                    <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="#FF9C72" />
                    <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="#E5764A" />
                    <SolidColorBrush x:Key="AccentButtonBackgroundDisabled" Color="#2B2825" />
                    <SolidColorBrush x:Key="AccentButtonForeground" Color="#1A0F08" />
                    <SolidColorBrush x:Key="AccentButtonForegroundPointerOver" Color="#1A0F08" />
                    <SolidColorBrush x:Key="AccentButtonForegroundPressed" Color="#1A0F08" />
                    <SolidColorBrush x:Key="AccentButtonForegroundDisabled" Color="#6E6862" />
                    <SolidColorBrush x:Key="AccentButtonBorderBrush" Color="Transparent" />
                    <SolidColorBrush x:Key="FocusVisualPrimaryBrush" Color="#FF8A5B" />
                    <SolidColorBrush x:Key="FocusVisualSecondaryBrush" Color="Transparent" />
                    <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="#FF8A5B" />
                    <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver" Color="#FF9C72" />
                    <SolidColorBrush x:Key="ToggleSwitchFillOnPressed" Color="#E5764A" />
                    <SolidColorBrush x:Key="ListViewItemBackgroundPointerOver" Color="#201D1A" />
                    <SolidColorBrush x:Key="ListViewItemBackgroundSelected" Color="#24201C" />
                    <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver" Color="#2A2521" />
                    <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPressed" Color="#2A2521" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <!-- 控件圆角 4，面板圆角 8：两档，不多不少。 -->
            <x:Double x:Key="ControlCornerRadius">4</x:Double>
            <CornerRadius x:Key="ControlCornerRadiusValue">4</CornerRadius>
            <x:Double x:Key="ControlContentThemeFontSize">13</x:Double>

            <FontFamily x:Key="KpTextFont">Segoe UI Variable Text</FontFamily>
            <FontFamily x:Key="KpDisplayFont">Segoe UI Variable Display</FontFamily>
            <FontFamily x:Key="KpMonoFont">Cascadia Mono, Consolas</FontFamily>

            <Style TargetType="TextBlock">
                <Setter Property="FontSize" Value="13" />
                <Setter Property="FontFamily" Value="{StaticResource KpTextFont}" />
            </Style>

            <!-- 表面 -->
            <Style x:Key="CardBorder" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource KpCardBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource KpRuleBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="16" />
            </Style>
            <Style x:Key="Hairline" TargetType="Border">
                <Setter Property="Height" Value="1" />
                <Setter Property="Background" Value="{ThemeResource KpRuleBrush}" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
            </Style>

            <!-- 字阶 -->
            <Style x:Key="PaneTitle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource KpDisplayFont}" />
                <Setter Property="FontSize" Value="17" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{ThemeResource KpInkBrush}" />
            </Style>
            <Style x:Key="TitleText" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource KpDisplayFont}" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{ThemeResource KpInkBrush}" />
            </Style>
            <Style x:Key="SectionHeader" TargetType="TextBlock">
                <Setter Property="FontSize" Value="13" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{ThemeResource KpInkBrush}" />
            </Style>
            <!-- 规格表上的小字：小一号、字距拉开、只作标记用。 -->
            <Style x:Key="MicroLabel" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="CharacterSpacing" Value="60" />
                <Setter Property="Foreground" Value="{ThemeResource KpInk2Brush}" />
            </Style>
            <Style x:Key="FieldLabel" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="CharacterSpacing" Value="40" />
                <Setter Property="Foreground" Value="{ThemeResource KpInk2Brush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
            <Style x:Key="FieldCaption" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="Foreground" Value="{ThemeResource KpInk2Brush}" />
            </Style>
            <Style x:Key="RequiredMark" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11" />
                <Setter Property="CharacterSpacing" Value="40" />
                <Setter Property="Foreground" Value="{ThemeResource KpSignalBrush}" />
            </Style>
            <Style x:Key="MonoText" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource KpMonoFont}" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="{ThemeResource KpInk2Brush}" />
            </Style>
            <!-- 账本里的编号：等宽、右对齐、定宽，1 与 10 的个位落在同一条竖线上。 -->
            <Style x:Key="LedgerNumber" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource KpMonoFont}" />
                <Setter Property="FontSize" Value="11" />
                <!-- 定宽 20 装不下 1.10：折叠组的第 10 个子步骤会被裁成 1.1（实测反馈）。
                     用最小宽度：个位数仍然对齐，多出来的位数往左伸进留白。 -->
                <Setter Property="MinWidth" Value="20" />
                <Setter Property="TextAlignment" Value="Right" />
                <Setter Property="Foreground" Value="{ThemeResource KpInk2Brush}" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <!-- 控件 -->
            <Style x:Key="ToolButton" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="Padding" Value="10,6" />
                <Setter Property="FontFamily" Value="{StaticResource KpTextFont}" />
            </Style>
            <!--
              主操作按钮：自绘模板。系统的 AccentButtonStyle 用的是框架自己的主题字典，
              应用级覆盖改不动它——换世界的时候不该再借别人的强调色。
            -->
            <Style x:Key="KpPrimaryButton" TargetType="Button">
                <Setter Property="Background" Value="{ThemeResource KpSignalBrush}" />
                <Setter Property="Foreground" Value="{ThemeResource KpOnSignalBrush}" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="Padding" Value="16,7" />
                <Setter Property="FontFamily" Value="{StaticResource KpTextFont}" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid x:Name="Root" Background="{TemplateBinding Background}"
                                  CornerRadius="{TemplateBinding CornerRadius}">
                                <ContentPresenter x:Name="Body" Content="{TemplateBinding Content}"
                                                  Padding="{TemplateBinding Padding}"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Root"
                                                                               Storyboard.TargetProperty="Background">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource KpSignalHoverBrush}" />
                                                </ObjectAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Root"
                                                                               Storyboard.TargetProperty="Background">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource KpSignalPressedBrush}" />
                                                </ObjectAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Disabled">
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Root"
                                                                               Storyboard.TargetProperty="Background">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource KpSignalOffBrush}" />
                                                </ObjectAnimationUsingKeyFrames>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Body"
                                                                               Storyboard.TargetProperty="Opacity">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="0.55" />
                                                </ObjectAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!--
              开关：轨道 + 一颗珠子。系统 ToggleSwitch 的开态走框架自己的强调色（蓝），
              应用级改不动，所以自绘：未选是墨三档的圈，选中是朱砂轨道 + 反色珠。
            -->
            <Style x:Key="KpSwitch" TargetType="ToggleButton">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="FontFamily" Value="{StaticResource KpTextFont}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToggleButton">
                            <StackPanel Orientation="Horizontal" Spacing="10" Background="Transparent">
                                <Border x:Name="Track" Width="34" Height="18" CornerRadius="9"
                                        Background="{ThemeResource KpFieldBrush}"
                                        BorderBrush="{ThemeResource KpInk3Brush}" BorderThickness="1">
                                    <Ellipse x:Name="Knob" Width="12" Height="12" Margin="2,0,0,0"
                                             HorizontalAlignment="Left" VerticalAlignment="Center"
                                             Fill="{ThemeResource KpInk3Brush}" />
                                </Border>
                                <ContentPresenter VerticalAlignment="Center" />
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CheckStates">
                                        <!-- 关键：ObjectAnimation 是保持的，状态里没写的属性会留着上一次的值。
                                             所以"关"必须像"开"一样把每个属性都写回去，否则点了只会变色一次。 -->
                                        <VisualState x:Name="Unchecked">
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Knob"
                                                                               Storyboard.TargetProperty="HorizontalAlignment">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="Left" />
                                                </ObjectAnimationUsingKeyFrames>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Knob"
                                                                               Storyboard.TargetProperty="Margin">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="2,0,0,0" />
                                                </ObjectAnimationUsingKeyFrames>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Knob"
                                                                               Storyboard.TargetProperty="Fill">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource KpInk3Brush}" />
                                                </ObjectAnimationUsingKeyFrames>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Track"
                                                                               Storyboard.TargetProperty="Background">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource KpFieldBrush}" />
                                                </ObjectAnimationUsingKeyFrames>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Track"
                                                                               Storyboard.TargetProperty="BorderBrush">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource KpInk3Brush}" />
                                                </ObjectAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Indeterminate" />
                                        <VisualState x:Name="Checked">
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Knob"
                                                                               Storyboard.TargetProperty="HorizontalAlignment">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="Right" />
                                                </ObjectAnimationUsingKeyFrames>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Knob"
                                                                               Storyboard.TargetProperty="Margin">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="0,0,2,0" />
                                                </ObjectAnimationUsingKeyFrames>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Knob"
                                                                               Storyboard.TargetProperty="Fill">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource KpOnSignalBrush}" />
                                                </ObjectAnimationUsingKeyFrames>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Track"
                                                                               Storyboard.TargetProperty="Background">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource KpSignalBrush}" />
                                                </ObjectAnimationUsingKeyFrames>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Track"
                                                                               Storyboard.TargetProperty="BorderBrush">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource KpSignalBrush}" />
                                                </ObjectAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </VisualState>
                                    </VisualStateGroup>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver" />
                                        <VisualState x:Name="Pressed" />
                                        <VisualState x:Name="Disabled" />
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                            </StackPanel>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!--
              菜单与工具提示：系统画的浮层，但面、线、圆角可以交给我们。
              阴影是弹层窗自己画的，不归这套系统管（与对话框同理）。
            -->
            <Style x:Key="KpFlyoutPresenter" TargetType="MenuFlyoutPresenter">
                <Setter Property="Background" Value="{ThemeResource KpCardBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource KpRuleBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="Padding" Value="4" />
                <Setter Property="MaxWidth" Value="380" />
            </Style>

            <!--
                弹出面板（Flyout）的壳。和上面的 KpFlyoutPresenter 是两套 type：
                MenuFlyoutPresenter 只吃菜单，普通 Flyout 的壳是 FlyoutPresenter，套错了会在运行时抛
                "Cannot apply a Style with TargetType ... to an object of type ..."。
            -->
            <Style x:Key="KpPopoverPresenter" TargetType="FlyoutPresenter">
                <Setter Property="Background" Value="{ThemeResource KpCardBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource KpRuleBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="Padding" Value="14,12" />
            </Style>

            <Style TargetType="ToolTip">
                <Setter Property="Background" Value="{ThemeResource KpCardBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource KpRuleBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="Padding" Value="8,6" />
                <Setter Property="FontFamily" Value="{StaticResource KpTextFont}" />
                <Setter Property="FontSize" Value="12" />
            </Style>

            <!-- 安静按钮：纸上的一个框。用于对话框的取消、次要动作。 -->
            <Style x:Key="KpQuietButton" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{ThemeResource KpInkBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource KpRuleBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="Padding" Value="14,6" />
                <Setter Property="FontFamily" Value="{StaticResource KpTextFont}" />
            </Style>

            <!-- 单选：一枚圈，选中时圈变朱砂、中间一颗朱砂点。系统的蓝不进入这张纸。 -->
            <Style TargetType="RadioButton">
                <Setter Property="Foreground" Value="{ThemeResource KpInkBrush}" />
                <Setter Property="FontFamily" Value="{StaticResource KpTextFont}" />
                <Setter Property="MinHeight" Value="26" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Grid Background="Transparent">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid Width="15" Height="15" VerticalAlignment="Center">
                                    <Ellipse x:Name="Ring" Stroke="{ThemeResource KpInk3Brush}" StrokeThickness="1.4" />
                                    <Ellipse x:Name="Dot" Width="7" Height="7" Fill="{ThemeResource KpSignalBrush}"
                                             Opacity="0" />
                                </Grid>
                                <ContentPresenter Grid.Column="1" Margin="8,0,0,0" Content="{TemplateBinding Content}"
                                                  VerticalAlignment="Center" />
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CheckStates">
                                        <VisualState x:Name="Unchecked" />
                                        <VisualState x:Name="Checked">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="Dot"
                                                                 Storyboard.TargetProperty="Opacity"
                                                                 To="1" Duration="0" />
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Ring"
                                                                               Storyboard.TargetProperty="Stroke">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource KpSignalBrush}" />
                                                </ObjectAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </VisualState>
                                    </VisualStateGroup>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Ring"
                                                                               Storyboard.TargetProperty="Stroke">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource KpInkBrush}" />
                                                </ObjectAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Ring"
                                                                               Storyboard.TargetProperty="Stroke">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource KpSignalBrush}" />
                                                </ObjectAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Disabled">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="Ring" Storyboard.TargetProperty="Opacity"
                                                                 To="0.4" Duration="0" />
                                            </Storyboard>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 输入面：纸色底 + 一条暖灰线，圆角 4。 -->
            <Style TargetType="TextBox">
                <Setter Property="Background" Value="{ThemeResource KpFieldBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource KpRuleBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="Padding" Value="8,6" />
                <Setter Property="FontFamily" Value="{StaticResource KpTextFont}" />
            </Style>

            <Style x:Key="PaletteButton" TargetType="Button">
                <Setter Property="Padding" Value="11,6" />
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="FontFamily" Value="{StaticResource KpTextFont}" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
