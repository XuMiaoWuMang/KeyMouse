<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>KeyMouse.FlowEditor</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>KeyMouse.FlowEditor</AssemblyName>
    <ApplicationTitle>KeyMouse 流程编辑器</ApplicationTitle>

    <!-- Unpackaged, and self-contained: measured on this machine the only Windows App Runtime present
         is the CBS (inbox) one, which the bootstrapper refuses (exit 0x80670016), while
         WindowsAppSDKSelfContained starts fine. It also means the editor needs nothing installed. -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.5.1" />
  </ItemGroup>

  <!-- Three layers, one product: the editor is the UI entry point and talks to the capability layer
       and the Runner through their assemblies. No schema is copied and no child process is spawned
       per action any more - the Runner is a service the editor connects to. -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\KeyMouse.Core\KeyMouse.Core.csproj" />
    <ProjectReference Include="..\..\src\KeyMouse.Runner\KeyMouse.Runner.csproj" />
  </ItemGroup>

</Project>